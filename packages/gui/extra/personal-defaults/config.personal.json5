{
  plugin: {
    node: {
      enabled: true,
    },
    git: {
      enabled: true,
    },
    overwall: {
      targets: {
        '^(?:[\\w-]+\\.)*(?:github[\\w-]*\\.(?:com|io|dev)|ghcr\\.io)$': false,
        'github.com': false,
        '*.github.com': false,
        '*github*.com': false,
        '*.githubusercontent.com': false,
        '*.githubassets.com': false,
        '*.github.io': false,
        // account/scholar 系会命中 pac.txt 被增强模式劫持到适配器「直连优先」,
        // 真实 SNI 直连偶被 GFW 放行时出口为本机地域, AI 模式间歇报地域拒绝
        // (2026-11-19)。显式 false 跳过增强(github.com 同例), 回香港中继直连路径,
        // 出口与 google 家族一致。
        '(*account*|scholar).google.com': false,
        'scholar.googleusercontent.com': false,
        // GitHub LFS 上传走 S3, 显式排除增强模式, 由默认功能(SNI 改写)直连
        'github-cloud.s3.amazonaws.com': false,
        '*.chatgpt.com': true,
        '*.openai.com': true,
        'auth.openai.com': true,
        'auth0.openai.com': true,
        '*.oaistatic.com': true,
        'claude.ai': true,
        '*.claude.ai': true,
        '*.anthropic.com': true,
        'api.anthropic.com': true,
        '*.googleapis.com': false,
        '*.gstatic.com': false,
        '*.google-analytics.com': false,
        '*.googleusercontent.com': false,
        // google 全家族显式关闭增强: www.google.com / www.google.com.hk / gemini / aistudio /
        // apis / console.cloud / notebooklm / mail 等都会命中 pac.txt(gfwlist)。一旦被增强劫持,
        // 请求就转发到本地适配器及其上游 VPN, 出口地域随 VPN 节点漂移; 漂到 CN 时 AI 模式报
        // 「您的设备或账号目前无法使用 AI 模式」, 且只在适配器死亡退避窗口内才恢复, 表现为
        // 间歇性故障(2026-11-19 定位)。关闭增强后这些域名走 regionPolicy + preSetIpListRelay
        // 的预设中继直连路径, 出口稳定在中继节点。内核另有中继守卫(overwall.js relayGuard)
        // 兜底, 即使这两条被误删/被远程配置冲掉, pac.txt 也无法把中继白名单家族劫持走。
        '^(?!fonts).*(with)?google(apis|usercontent)?.com.*$': false,
        '^(aistudio|.*pa.clients6|apis|gemini|console.cloud|notebooklm|mail).google.com$': false,
        // 精确主机级 false: 合并后用户键排在远程键之前, 正则层远程新增 true 会被上面的宽匹配
        // 正则先命中而失效; 但远程若新增「精确主机」true, 会在 origin 快速匹配层先于正则被
        // 取到(2026-11-19 覆盖性证明实验)。对 AI 模式关键主机补精确 false 堵死该路径。
        'www.google.com': false,
        'www.google.com.hk': false,
        'gemini.google.com': false,
        'accounts.google.com': false,
        'chatgpt.com': true,
        'openai.com': true,
      },
      enabled: true,
      pac: {
        enabled: true,
        autoUpdate: true,
      },
    },
    pip: {},
  },
  proxy: {
    excludeDomesticDomainAllowList: true,
    proxyHttp: true,
    setEnv: true,
    excludeIpList: {
      '*.miyun.io': false,
      '*.sigs.k8s.io': false,
      '*.elastic.co': true,
      'objects-origin.githubusercontent.com': null,
    },
  },
  app: {
    autoStart: {
      enabled: true,
    },
    autoChecked: false,
    dock: {
      hideWhenWinClose: true,
    },
    theme: 'system',
    closeStrategy: 2,
    showShutdownTip: false,
    mode: 'ow',
  },
  server: {
    dns: {
      ech: {
        domains: [
          '*t.co',
          '*twitter.com',
          '*twimg.com',
          '*sci-hub.pub',
          '^(.+.)?x.com$',
          '*matrix.org',
          '*mod.io',
          '*itch.io',
          '*patreon.com',
          '*substack.com',
          '*medium.com',
          '*v2ex.com',
          'auth.docker.io',
          'hub.docker.com',
          '*pixiv.net',
          '*civitai.com',
          '*civitai.red',
          '*ldstatic.com',
          'civitai.com',
          '*linux.do',
          'greasyfork.org',
        ],
      },
      mapping: {
        '*.openai.com': 'cf-DoT',
        'auth.openai.com': 'cf-DoT',
        '*.oaiusercontent.com': 'cf-DoT',
        '*.claude.ai': 'cf-DoT',
        '*.anthropic.com': 'cf-DoT',
        '*.google.com': 'cf-DoT',
        '*.googleapis.com': 'cf-DoT',
        '*.googleusercontent.com': 'cf-DoT',
        '*.gstatic.com': 'cf-DoT',
      },
      familyMapping: {
        '*.github.com': null,
        '*github*.com': null,
        '*duckduckgo.com': null,
        '*.gstatic.com': null,
        '*.googleapis.com': null,
        // 本机无 IPv6: 抵消官方远程对 YouTube 视频投递域强制 family 6 的映射,
        // 否则这些域名解析 AAAA 后 EHOSTUNREACH 并触发内核 null socket 崩溃
        '*.xn--ngstr-lra8j.com': null,
        '*.googlevideo.com': null,
        '*.gvt1.com': null,
      },
      speedTest: {
        dnsProviders: [
          'local',
          'aliyun',
          'safe360',
          'cf-DoT',
          'bebasid',
          'cf-DoH',
          'quad9-ip',
          'cf-ip',
          'rubyfish',
        ],
        hostnameList: [
          'miyun.io',
          'minikube.sigs.k8s.io',
          'api.github.com',
          'collector.github.com',
          'githubusercontent.com',
          'google.com.hk',
          'google.com',
          'github.com',
        ],
      },
    },
    intercepts: {
      '*.claude.ai': null,
      // GitHub 资源文件名多数带点(chunkID.hash.js / xxx.module.css), 官方远程配置的
      // 改写正则 [^./]+ 排除点, 带点资源带真实 SNI 出去被重置, 页面裸渲染(2026-11-18 真因)。
      // 补一条覆盖带点文件名的改写规则, 顺带覆盖 .map 消除 DevTools 源映射 7 秒挂起。
      'github.githubassets.com': {
        '^/assets/.*\\.(js|css|svg|png|gif|jpg|jpeg|ico|woff2?|map|json)(\\?.*)?$': {
          sni: 'baidu.com',
          cacheDays: 365,
        },
      },
      // GitHub LFS 的 S3 上传域名: 真实 SNI 被 SNI 层阻断, 用 baidu.com 敲门即可正常握手
      // (S3 证书覆盖 *.s3.amazonaws.com, 无需 unVerifySsl), 默认功能直连, 不经兜底适配器
      'github-cloud.s3.amazonaws.com': {
        '.*': {
          sni: 'baidu.com',
        },
      },
    },
    setting: {
      tlsVersionMapping: {},
    },
    cloudflareRoute: {
      mode: 'blacklist',
      domains: {},
      enabled: true,
    },
    preSetIpList: {
      'miyun.io': {
        '104.21.74.96': true,
      },
      // GitHub 静态资源 CDN: 用户层整键覆盖远程预设表, 在官方 .154 组基础上
      // 并入实时 DNS 返回的 .215 组, 扩大轮换池以抵御单组 Fastly IP 间歇性阻断
      'github.githubassets.com': {
        '185.199.108.154': true,
        '185.199.109.154': true,
        '185.199.110.154': true,
        '185.199.111.154': true,
        '185.199.108.215': true,
        '185.199.109.215': true,
        '185.199.110.215': true,
        '185.199.111.215': true,
      },
    },
    // 地域自适应预设(2026-11-19): 内核探测直连出口地域落在
    // regionPolicy.restrictedRegions 时, 以下家族使用中继池(白名单语义,
    // 不受官方远程预设增删影响, 无抵消标记被合并写回消耗的问题); 出口不在
    // 受限地域时(如海外环境)落回官方/远程预设直连, 不绕道中继。
    preSetIpListRelay: {
      '^(aistudio|.*pa.clients6|apis|gemini|console.cloud|notebooklm|mail).google.com$': {
        '8.137.102.117': true,
      },
      '^(?!fonts).*(with)?google(apis|usercontent)?.com.*$': {
        '8.137.102.117': true,
      },
      '(*account*|scholar).google.com': {
        '8.137.102.117': true,
      },
      'scholar.googleusercontent.com': {
        '8.137.102.117': true,
      },
      // youtube/gstatic/stitch 家族同属地域敏感: 受限地域走中继, 非受限地域落回
      // 官方预设直连(2026-11-19 应用户要求: 不被封锁时不强制绕道中继)。原先写在
      // 无条件 preSetIpList 里会使海外出口也固定在中继, 与地域自适应设计相悖。
      'stitch.withgoogle.com': {
        '8.137.102.117': true,
      },
      '^.*(youtube.com|gstatic.com|youtube.nocookie.com|youtu.be|ggpht.com|i.ytimg.com|blogger.com|doodles.google|about.google|android.com|antigravity.google)$': {
        '8.137.102.117': true,
      },
      '*.youtube.com': {
        '8.137.102.117': true,
      },
      '*.youtu.be': {
        '8.137.102.117': true,
      },
      '*.youtube-nocookie.com': {
        '8.137.102.117': true,
      },
      '*.ggpht.com': {
        '8.137.102.117': true,
      },
      'i.ytimg.com': {
        '8.137.102.117': true,
      },
      '*.gstatic.com': {
        '8.137.102.117': true,
      },
    },
    regionPolicy: {
      restrictedRegions: ['CN'],
      // ipinfo 在国内直连可达且返回 country_code, 作首选探测源;
      // 全部失败时按 defaultRestricted 保守走中继
      probes: ['https://ipinfo.io/json', 'https://ipapi.co/json/', 'http://ip-api.com/json'],
      ttlMs: 1800000,
      defaultRestricted: true,
    },
    whiteList: {
      '*.bigmodel.cn': true,
    },
  },
}
