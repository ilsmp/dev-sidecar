// 个人默认配置模板 —— 2026-11-19 由当前验证可用的活配置固化生成
// 安装时种入用户层(~/.dev-sidecar/config.json), 合并优先级最高, 不被远程覆盖。
// 注意: 固化为全量快照后, 官方远程配置的未来更新不会自动生效(用户层优先);
// 如需吸收官方更新, 用 scripts/check-preset-leaks.mjs 审计后重新固化。
// 地域自适应: regionPolicy 探测直连出口, CN 时 google 系走 preSetIpListRelay 中继池,
// 非受限地域落回本文件 preSetIpList(即当前固化的官方预设快照)。
{
  "plugin": {
    "node": {
      "enabled": true
    },
    "git": {
      "enabled": true
    },
    "overwall": {
      "targets": {
        "^(?:[\\w-]+\\.)*(?:github[\\w-]*\\.(?:com|io|dev)|ghcr\\.io)$": false,
        "github.com": false,
        "*.github.com": false,
        "*github*.com": false,
        "*.githubusercontent.com": false,
        "*.githubassets.com": false,
        "*.github.io": false,
        "(*account*|scholar).google.com": false,
        "scholar.googleusercontent.com": false,
        "github-cloud.s3.amazonaws.com": false,
        "*.chatgpt.com": true,
        "*.openai.com": true,
        "auth.openai.com": true,
        "auth0.openai.com": true,
        "*.oaistatic.com": true,
        "claude.ai": true,
        "*.claude.ai": true,
        "*.anthropic.com": true,
        "api.anthropic.com": true,
        "*.googleapis.com": false,
        "*.gstatic.com": false,
        "*.google-analytics.com": false,
        "*.googleusercontent.com": false,
        "chatgpt.com": true,
        "openai.com": true,
        "^(?!fonts).*(with)?google(apis|usercontent)?.com.*$": false,
        "^(aistudio|.*pa.clients6|apis|gemini|console.cloud|notebooklm|mail).google.com$": false
      },
      "enabled": true
    },
    "pip": {}
  },
  "proxy": {
    "proxyHttp": true,
    "setEnv": true,
    "excludeIpList": {
      "*.miyun.io": false,
      "*.sigs.k8s.io": false,
      "*.elastic.co": true,
      "objects-origin.githubusercontent.com": null
    }
  },
  "app": {
    "autoStart": {
      "enabled": true
    },
    "autoChecked": false,
    "dock": {
      "hideWhenWinClose": true
    },
    "theme": "system",
    "closeStrategy": 2,
    "showShutdownTip": false,
    "mode": "ow"
  },
  "server": {
    "dns": {
      "ech": {
        "domains": [
          "*t.co",
          "*twitter.com",
          "*twimg.com",
          "*sci-hub.pub",
          "^(.+.)?x.com$",
          "*matrix.org",
          "*mod.io",
          "*itch.io",
          "*patreon.com",
          "*substack.com",
          "*medium.com",
          "*v2ex.com",
          "auth.docker.io",
          "hub.docker.com",
          "*pixiv.net",
          "*civitai.com",
          "*civitai.red",
          "*ldstatic.com",
          "civitai.com",
          "*linux.do",
          "greasyfork.org"
        ]
      },
      "mapping": {
        "*.openai.com": "cf-DoT",
        "auth.openai.com": "cf-DoT",
        "*.oaiusercontent.com": "cf-DoT",
        "*.claude.ai": "cf-DoT",
        "*.anthropic.com": "cf-DoT",
        "*.google.com": "cf-DoT",
        "*.googleapis.com": "cf-DoT",
        "*.googleusercontent.com": "cf-DoT",
        "*.gstatic.com": "cf-DoT"
      },
      "familyMapping": {
        "*.xn--ngstr-lra8j.com": null,
        "*.googlevideo.com": null,
        "*.gvt1.com": null,
        "*.github.com": null,
        "*github*.com": null,
        "*duckduckgo.com": null,
        "*.gstatic.com": null,
        "*.googleapis.com": null
      },
      "speedTest": {
        "dnsProviders": [
          "local",
          "aliyun",
          "safe360",
          "cf-DoT",
          "bebasid",
          "cf-DoH",
          "quad9-ip",
          "cf-ip",
          "rubyfish"
        ],
        "hostnameList": [
          "miyun.io",
          "minikube.sigs.k8s.io",
          "api.github.com",
          "collector.github.com",
          "githubusercontent.com",
          "google.com.hk",
          "google.com",
          "github.com"
        ]
      }
    },
    "intercepts": {
      "github.githubassets.com": {
        "^/assets/.*\\.(js|css|svg|png|gif|jpg|jpeg|ico|woff2?|map|json)(\\?.*)?$": {
          "sni": "baidu.com",
          "cacheDays": 365
        }
      },
      "github-cloud.s3.amazonaws.com": {
        ".*": {
          "sni": "baidu.com"
        }
      },
      "*.claude.ai": null
    },
    "setting": {
      "tlsVersionMapping": {}
    },
    "cloudflareRoute": {
      "mode": "blacklist",
      "domains": {},
      "enabled": true
    },
    "preSetIpList": {
      "stitch.withgoogle.com": {
        "8.137.102.117": true
      },
      "miyun.io": {
        "104.21.74.96": true
      },
      "^.*(youtube.com|gstatic.com|youtube.nocookie.com|youtu.be|ggpht.com|i.ytimg.com|blogger.com|doodles.google|about.google|android.com|antigravity.google)$": {
        "8.137.102.117": true,
        "142.251.189.206": false
      },
      "*.youtube.com": {
        "8.137.102.117": true
      },
      "*.youtu.be": {
        "8.137.102.117": true
      },
      "*.youtube-nocookie.com": {
        "8.137.102.117": true
      },
      "*.ggpht.com": {
        "8.137.102.117": true
      },
      "i.ytimg.com": {
        "8.137.102.117": true
      },
      "*.gstatic.com": {
        "8.137.102.117": true
      },
      "github.githubassets.com": {
        "185.199.108.215": true,
        "185.199.109.215": true,
        "185.199.110.215": true,
        "185.199.111.215": true
      }
    },
    "preSetIpListRelay": {
      "^(aistudio|.*pa.clients6|apis|gemini|console.cloud|notebooklm|mail).google.com$": {
        "8.137.102.117": true
      },
      "^(?!fonts).*(with)?google(apis|usercontent)?.com.*$": {
        "8.137.102.117": true
      },
      "(*account*|scholar).google.com": {
        "8.137.102.117": true
      },
      "scholar.googleusercontent.com": {
        "8.137.102.117": true
      }
    },
    "regionPolicy": {
      "restrictedRegions": [
        "CN"
      ],
      "probes": [
        "https://ipinfo.io/json",
        "https://ipapi.co/json/",
        "http://ip-api.com/json"
      ],
      "ttlMs": 1800000,
      "defaultRestricted": true
    },
    "whiteList": {
      "*.bigmodel.cn": true
    }
  }
}
